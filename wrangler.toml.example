# Isolated email Worker; no shared bindings with parkmemoir-public-p0.
# Candidate only: replace D1 UUID and enable reviewed custom domain before deploy.
name = "parkmemoir-email"
main = "worker.mjs"
compatibility_date = "2026-11-09"
workers_dev = false
preview_urls = false

# AFTER APPROVAL, enable this reviewed custom domain:
# [[routes]]
# pattern = "email.parkmemoir.com"
# custom_domain = true

# Complete PDF rendering of the existing browser print DOM, via Cloudflare Browser Run.
# Available on Workers Free with a daily browser-time quota.
[browser]
binding = "BROWSER"

[[d1_databases]]
binding = "SUBSCRIBERS"
database_name = "parkmemoir-email-consent"
database_id = "SET_REAL_D1_DATABASE_ID_AFTER_MIGRATION"

[vars]
EMAIL_FROM = "PARKMEMOIR <plans@mail.parkmemoir.com>"
SEASONAL_SEGMENT_ID = "SET_REAL_RESEND_SEGMENT_ID"
SEASONAL_TOPIC_ID = "SET_REAL_RESEND_TOPIC_ID"

# Never commit secret VALUES. Validate secret names before source-based upload/deploy.
[secrets]
required = ["RESEND_API_KEY", "RESEND_CONTACTS_API_KEY", "TURNSTILE_SECRET_KEY", "RATE_HASH_SECRET"]

# Worker Secrets (not vars): RESEND_API_KEY (sending-only, domain-limited), RESEND_CONTACTS_API_KEY (separate full-access for DOI), TURNSTILE_SECRET_KEY, RATE_HASH_SECRET.
# CAUTION: `wrangler secret put` deploys immediately. Use dashboard or `wrangler versions secret put` during staged setup.
[triggers]
crons = ["0 6 * * *"]
